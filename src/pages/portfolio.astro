---
// src/pages/portfolio.astro
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout title="Thomas Brink | Portfolio Projects">
  <div class="o-stack o-stack--lg">
    <header class="c-section-header">
      <h1 class="c-section-header__title">Featured Projects</h1>
      <p class="c-section-header__description">
        A collection of open-source tools, case studies, and web platforms.
      </p>

      <!-- Active Filter Banner (Controlled by client JS) -->
      <div id="filter-banner" class="c-filter-banner u-hidden">
        <span class="c-filter-banner__text">
          Filtering by skill: <strong id="filter-name" class="c-filter-banner__highlight"></strong>
        </span>
        <a href="/portfolio" class="c-filter-banner__reset">
          Clear filter ✕
        </a>
      </div>
    </header>

    {projects.length === 0 ? (
      <p class="c-notice">No projects added yet.</p>
    ) : (
      <div id="projects-grid" class="o-grid o-grid--2col">
        {projects.map(async (project) => {
          const { Content } = await render(project);
          const rawTags = project.data.tags ? project.data.tags.split(',').map((t: string) => t.trim()) : [];
          const normalizedTags = rawTags.map((t: string) => t.toLowerCase());

          return (
            <article 
              class="c-project-card"
              data-tags={normalizedTags.join(',')}
            >
              <div class="c-project-card__body">
                <h2 class="c-project-card__title">{project.data.title}</h2>
                <p class="c-project-card__summary">{project.data.summary}</p>
                
                {rawTags.length > 0 && (
                  <div class="c-project-card__tags">
                    {rawTags.map((tag: string) => (
                      <a 
                        href={`/portfolio?tag=${encodeURIComponent(tag.toLowerCase())}`}
                        class="c-badge c-badge--pill c-badge--interactive"
                      >
                        {tag}
                      </a>
                    ))}
                  </div>
                )}
              </div>

              <div class="c-project-card__actions">
                {project.data.liveUrl && (
                  <a href={project.data.liveUrl} target="_blank" rel="noreferrer" class="c-project-card__link c-project-card__link--primary">
                    Live Demo &rarr;
                  </a>
                )}
                {project.data.repoUrl && (
                  <a href={project.data.repoUrl} target="_blank" rel="noreferrer" class="c-project-card__link c-project-card__link--secondary">
                    Code &rarr;
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</Layout>

<script>
  // Read ?tag= from the URL and toggle visibility
  const params = new URLSearchParams(window.location.search);
  const activeTag = params.get('tag')?.toLowerCase();

  if (activeTag) {
    const banner = document.getElementById('filter-banner');
    const filterName = document.getElementById('filter-name');
    const cards = document.querySelectorAll<HTMLElement>('.c-project-card');

    if (banner && filterName) {
      banner.classList.remove('u-hidden');
      banner.classList.add('u-flex');
      filterName.textContent = activeTag;
    }

    cards.forEach((card) => {
      const cardTags = card.dataset.tags ? card.dataset.tags.split(',') : [];
      if (!cardTags.includes(activeTag)) {
        card.style.display = 'none';
      }
    });
  }
</script>