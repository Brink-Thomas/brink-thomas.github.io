---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Personal CV and Project Portfolio" 
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen flex flex-col justify-between max-w-4xl mx-auto px-6 py-12">
    <div>
      <!-- Top Navigation -->
      <header class="flex items-center justify-between border-b border-slate-800 pb-6 mb-12">
        <a href="/" class="text-xl font-bold tracking-tight text-white hover:text-sky-400 transition-colors">
          Thomas Brink<span class="text-sky-400">.</span>
        </a>

        <nav class="flex gap-6 text-sm font-medium">
          <a 
            href="/" 
            class={currentPath === "/" ? "text-sky-400 font-semibold" : "text-slate-400 hover:text-slate-200 transition-colors"}
          >
            About & CV
          </a>
          <a 
            href="/portfolio" 
            class={currentPath.startsWith("/portfolio") ? "text-sky-400 font-semibold" : "text-slate-400 hover:text-slate-200 transition-colors"}
          >
            Portfolio
          </a>
        </nav>
      </header>

      <!-- Main Page Content injected here -->
      <main>
        <slot />
      </main>
    </div>

    <!-- Footer -->
    <footer class="mt-20 pt-6 border-t border-slate-900 text-xs text-slate-500 text-center">
      © {new Date().getFullYear()} Thomas Brink. Built with Astro & Pages CMS.
    </footer>
  </body>
</html>