---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #0f172a;
        --card: #1e293b;
        --text: #f8fafc;
        --text-muted: #94a3b8;
        --accent: #38bdf8;
      }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background: var(--bg);
        color: var(--text);
        max-width: 800px;
        margin: 0 auto;
        padding: 2.5rem 1rem;
        line-height: 1.6;
      }
      nav {
        display: flex;
        gap: 1.5rem;
        border-bottom: 1px solid var(--card);
        padding-bottom: 1rem;
        margin-bottom: 2rem;
      }
      nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 600;
        font-size: 1.1rem;
      }
      nav a:hover {
        color: var(--accent);
      }
      a { color: var(--accent); }
      .card {
        background: var(--card);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">About Me</a>
      <a href="/portfolio">Portfolio</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>