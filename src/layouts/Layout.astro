---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Personal CV and Project Portfolio" 
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="u-scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="o-site-layout">
    <div class="o-site-layout__body">
      <!-- Top Navigation -->
      <header class="c-navbar">
        <a href="/" class="c-navbar__brand">
          Thomas Brink<span class="c-navbar__brand-accent">.</span>
        </a>

        <nav class="c-nav">
          <ul class="c-nav__list">
            <li class="c-nav__item">
              <a 
                href="/" 
                class:list={["c-nav__link", { "is-active": currentPath === "/" }]}
              >
                About & CV
              </a>
            </li>
            <li class="c-nav__item">
              <a 
                href="/portfolio" 
                class:list={["c-nav__link", { "is-active": currentPath.startsWith("/portfolio") }]}
              >
                Portfolio
              </a>
            </li>
          </ul>
        </nav>
      </header>

      <!-- Main Page Content injected here -->
      <main class="o-site-layout__main">
        <slot />
      </main>
    </div>

    <!-- Footer -->
    <footer class="c-footer">
      <p class="c-footer__copyright">© {new Date().getFullYear()} Thomas Brink.</p>
    </footer>
  </body>
</html>